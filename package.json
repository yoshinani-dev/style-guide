{
  "name": "@yoshinani/style-guide",
  "version": "2.0.0-beta.0",
  "description": "YOSHINANI's Style Guide",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "pnpm": "10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/yoshinani-dev/style-guide#readme",
  "bugs": {
    "url": "https://github.com/yoshinani-dev/style-guide/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshinani-dev/style-guide.git"
  },
  "scripts": {
    "prepare": "husky",
    "prepack": "vp pack",
    "release": "changeset publish",
    "build": "vp pack",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp pack && vp test",
    "test:tsconfig": "node tests/tsconfig.ts",
    "verify": "pnpm run check && pnpm run test:tsconfig && pnpm run test",
    "verify:full": "pnpm run verify && pnpm --package=typescript@6 dlx node tests/tsconfig.ts && pnpm --package=typescript@7 dlx node tests/tsconfig.ts && git diff --exit-code package.json"
  },
  "exports": {
    "./commitlint": "./dist/commitlint/index.mjs",
    "./oxfmt": "./dist/oxfmt/index.mjs",
    "./oxlint/base": "./dist/oxlint/base.mjs",
    "./oxlint/base-effect": "./dist/oxlint/base-effect.mjs",
    "./oxlint/library": "./dist/oxlint/library.mjs",
    "./oxlint/library-effect": "./dist/oxlint/library-effect.mjs",
    "./oxlint/next": "./dist/oxlint/next.mjs",
    "./oxlint/next-effect": "./dist/oxlint/next-effect.mjs",
    "./oxlint/plugins/yoshinani": "./dist/oxlint/plugins/yoshinani.mjs",
    "./oxlint/react-library": "./dist/oxlint/react-library.mjs",
    "./oxlint/react-library-effect": "./dist/oxlint/react-library-effect.mjs",
    "./oxlint/rules/effect": "./dist/oxlint/rules/effect.mjs",
    "./oxlint/rules/react": "./dist/oxlint/rules/react.mjs",
    "./oxlint/rules/restricted-imports": "./dist/oxlint/rules/restricted-imports.mjs",
    "./package.json": "./package.json",
    "./typescript": "./typescript/base.json",
    "./typescript/*": "./typescript/*.json"
  },
  "files": [
    "cspell",
    "dist",
    "typescript"
  ],
  "dependencies": {
    "@commitlint/config-conventional": "^20.5.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@effect/tsgo": "^0.63.0",
    "@oxlint/plugins": "1.90.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "effect": "^4.1.1",
    "husky": "^9.1.7",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "5.9.3",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "@commitlint/cli": "^20",
    "@effect/tsgo": ">=0.63.0",
    "oxfmt": ">=0.74.0",
    "oxlint": ">=1.89.0",
    "oxlint-tsgolint": ">=7.0.2004",
    "typescript": "^5 || ^6 || ^7",
    "vite-plus": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "@effect/tsgo": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  }
}
