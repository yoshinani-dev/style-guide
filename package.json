{
  "name": "@yoshinani/style-guide",
  "version": "1.0.8",
  "description": "YOSHINANI's Style Guide",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "pnpm": "10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/yoshinani-dev/style-guide#readme",
  "bugs": {
    "url": "https://github.com/yoshinani-dev/style-guide/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshinani-dev/style-guide.git"
  },
  "scripts": {
    "prepare": "husky",
    "release": "changeset publish",
    "check": "oxfmt --check . && oxlint --disable-nested-config",
    "check:fix": "oxfmt . && oxlint --disable-nested-config --fix",
    "test": "vitest run",
    "test:tsconfig": "node tests/tsconfig.mjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./commitlint": "./commitlint/commitlint.config.mjs",
    "./oxfmt": "./oxfmt/base.mjs",
    "./oxlint/*": "./oxlint/*.mjs",
    "./typescript": "./typescript/base.json",
    "./typescript/effect": "./typescript/effect.json",
    "./typescript/next": "./typescript/next.json",
    "./typescript/next-effect": "./typescript/next-effect.json",
    "./typescript/react-library": "./typescript/react-library.json",
    "./typescript/react-library-effect": "./typescript/react-library-effect.json"
  },
  "files": [
    "commitlint",
    "cspell",
    "oxfmt",
    "oxlint",
    "typescript"
  ],
  "dependencies": {
    "@commitlint/config-conventional": "^20.5.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^20.5.3",
    "@effect/tsgo": "^0.63.0",
    "@oxlint/plugins": "^1.90.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "effect": "^4.1.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "@commitlint/cli": "^20",
    "@effect/tsgo": ">=0.63.0",
    "oxfmt": ">=0.75.0",
    "oxlint": ">=1.90.0",
    "oxlint-tsgolint": ">=7.0.2005",
    "typescript": "^5 || ^6 || ^7"
  },
  "peerDependenciesMeta": {
    "@effect/tsgo": {
      "optional": true
    }
  }
}
