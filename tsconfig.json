{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "commitlint/**/*.mjs",
    "oxfmt/**/*.mjs",
    "oxlint/**/*.mjs",
    "tests/**/*.mjs",
    "oxfmt.config.ts",
    "oxlint.config.ts"
  ]
}
