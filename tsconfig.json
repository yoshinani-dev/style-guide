{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    // TypeScript 7 では node_modules 内の型定義（vitest と chai）が重複定義のエラーになるため
    "skipLibCheck": true
  },
  "include": [
    "commitlint/**/*.mjs",
    "oxfmt/**/*.mjs",
    "oxlint/**/*.mjs",
    "tests/**/*.mjs",
    "oxfmt.config.ts",
    "oxlint.config.ts"
  ]
}
